7px}.wf-edge-form{margin-top:18px}.wf-workspace .wf-expression{font-family:monospace;border:0;background:var(--bg);font-size:10px;display:block;width:100%;text-align:left;margin:5px 0;overflow-wrap:anywhere}.wf-run-link{display:block;width:100%;text-align:left;margin:8px 0}.wf-run-link small{display:block;font-size:9px;margin-top:5px;color:var(--text-dim)}.wf-inspector .wf-run{padding:12px;margin-top:15px}.wf-inspector .wf-run>summary{font-size:11px;flex-wrap:wrap}.wf-proposal{padding:14px;border:1px solid var(--border);border-radius:10px;margin-top:20px}.wf-proposal p{font-size:11px;line-height:1.6}.wf-proposal button{font-size:10px;margin:6px 5px 0 0}.wf-running-strip{padding:12px 20px;border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;background:var(--bg-raised);font-size:12px}.wf-running-strip span{flex:1}\n.wf-modal-backdrop{position:fixed;inset:0;background:#11254766;z-index:90;display:grid;place-items:center;padding:25px}.wf-modal{width:min(540px,100%);max-height:90vh;overflow:auto;background:var(--bg-raised);border:1px solid var(--border);border-radius:16px;padding:26px;box-shadow:0 25px 75px #10234333}.wf-modal .wf-heading{align-items:center;margin-bottom:15px}.wf-modal h3{margin:0;font-size:18px}\n@media(max-width:1200px){.wf-builder-body{grid-template-columns:minmax(240px,1fr) 250px}.wf-palette{display:none;position:absolute;left:10px;top:10px;bottom:10px;width:175px;z-index:12;box-shadow:0 8px 30px #142d501c;border:1px solid var(--border);border-radius:10px}.wf-palette.show{display:block}.companion-hub .hub-content{padding:23px 20px 45px}.wf-saved{flex-wrap:wrap}.wf-row-actions{margin-left:auto}.wf-flow-icon{align-self:flex-start}}\n@media(max-width:960px){.companion-hub .hub-shell{grid-template-columns:145px minmax(0,1fr)}.companion-hub .hub-rail{padding-left:8px;padding-right:8px}.companion-hub .hub-rail button{font-size:11px;padding:10px 8px}.companion-hub .hub-content{padding:20px 16px 40px}.wf-templates{grid-template-columns:1fr}.wf-list-tools{flex-wrap:wrap;gap:10px}.wf-list-tools input{max-width:none}.wf-heading h2{font-size:21px}.wf-prompt-bar{flex-wrap:wrap}.wf-prompt-bar input{min-width:150px!important}.wf-prompt-bar button{margin-left:auto}.wf-builder-header{flex-wrap:wrap;padding:14px}.wf-builder-title{flex-basis:50%}.wf-builder-actions{width:100%;justify-content:flex-end}.wf-builder-body{grid-template-columns:minmax(0,1fr);height:auto;min-height:0}.wf-viewport{height:500px;min-height:400px}.wf-inspector{border-left:0;border-top:1px solid var(--border);max-height:500px;display:block}.wf-inspector .wf-field{max-width:650px}.wf-palette{bottom:auto;max-height:460px}.wf-builder-tools{padding:9px 12px}.wf-canvas-hint,.wf-validation{padding:10px 14px}}\n@media(max-width:740px){.companion-hub .hub-shell{grid-template-columns:124px minmax(0,1fr)}.companion-hub .hub-rail{padding:16px 5px 20px 7px}.companion-hub .hub-rail-label{font-size:8px;padding:2px 6px 13px}.companion-hub .hub-rail button{font-size:10px;padding:9px 7px}.companion-hub .hub-content{padding:18px 12px 35px}.wf-saved{padding:14px;gap:10px}.wf-saved-info{flex-basis:calc(100% - 55px)}.wf-saved .wf-row-actions{width:100%;justify-content:flex-end}.wf-heading{gap:13px}.wf-heading h2{font-size:19px}.wf-heading p{font-size:12px}.wf-run-filters{grid-template-columns:1fr;gap:0}.wf-section-heading{align-items:flex-start;flex-wrap:wrap}.wf-builder-header>button{padding:6px 8px}.wf-builder-title h2{font-size:16px}.wf-builder-actions button{padding:7px 9px}.wf-viewport{height:430px}.wf-modal-backdrop{padding:15px}.wf-modal{padding:20px}.wf-running-strip{flex-wrap:wrap}}\n\n/* Keep each catalog filter label beside its own control. */\n.companion-hub .cn-categories .cn-category-picker{display:flex;flex-direction:column;align-items:flex-start;gap:7px;min-width:180px;max-width:280px;flex:1}.companion-hub .cn-category-picker select{width:100%;min-width:0}\n","workspace-shell.css":"/* Shared visual specification, bundled independently by each plugin. */\nhtml,body{width:100%;height:100%;margin:0}\nbody{overflow:hidden}\nbody #app,body #main{width:100%;height:100%;min-height:0;margin:0;padding:0}\nbody #main,.plugin-workspace{overflow:auto}\n.view.companion-hub{max-width:none;width:100%;min-height:100%;height:auto;margin:0;padding:0;overflow:visible}\n.companion-hub .hub-shell{display:grid;grid-template-columns:178px minmax(0,1fr);gap:0;align-items:stretch;min-height:100vh}\n.companion-hub .hub-rail{position:sticky;top:0;align-self:start;display:flex;flex-direction:column;gap:6px;min-height:100vh;max-height:100vh;overflow-y:auto;padding:24px 12px;border-right:1px solid #dce6f5;background:linear-gradient(180deg,#fbfdff,#f4f8ff);scrollbar-width:thin}\n.companion-hub .hub-rail-label{padding:0 10px 12px;color:#7184a0;font-size:10px;font-weight:650;letter-spacing:.1em;line-height:1.5;text-transform:uppercase}\n.companion-hub .hub-rail button{position:relative;display:block;width:100%;min-height:42px;margin:0;padding:11px 12px;border:1px solid transparent;border-radius:11px;background:transparent!important;color:#58708f!important;font-family:inherit;font-size:12px;font-weight:500;line-height:1.5;text-align:left;white-space:normal;overflow-wrap:anywhere;box-shadow:none;transition:background .15s,border-color .15s,box-shadow .15s,color .15s}\n.companion-hub .hub-rail button:hover{color:#155eef!important;border-color:#dce7fa;background:#fff!important;box-shadow:0 2px 7px #16376408}\n.companion-hub .hub-rail button.active{color:#155eef!important;font-weight:650;border-color:#cfdefb;background:linear-gradient(120deg,#e8f1ff,#f2f7ff)!important;box-shadow:0 2px 6px #155eef0a,inset 0 1px #ffffffc0}\n.companion-hub .hub-rail button:focus-visible{outline:2px solid #155eef;outline-offset:2px}\n.companion-hub .hub-content{min-width:0;padding:24px 26px 40px}\n.companion-hub>.hub-notice:not(:empty),.companion-hub>.an-notice:not(:empty){margin:14px 20px}\n.companion-hub .hub-shell:has(.wf-builder){grid-template-columns:minmax(0,1fr)}\n.companion-hub .hub-shell:has(.wf-builder)>.hub-rail{display:none}\n.companion-hub .hub-shell:has(.wf-builder)>.hub-content{padding:0}\n@media(max-width:960px){.companion-hub .hub-shell{grid-template-columns:158px minmax(0,1fr)}.companion-hub .hub-rail{padding:20px 10px}.companion-hub .hub-content{padding:20px}}\n@media(max-width:600px){.companion-hub .hub-shell{grid-template-columns:minmax(0,1fr);min-height:0}.companion-hub .hub-rail{position:static;flex-direction:row;flex-wrap:wrap;min-height:0;max-height:none;overflow:visible;padding:12px;border-right:0;border-bottom:1px solid #dce6f5;gap:6px}.companion-hub .hub-rail-label{width:100%;padding:0 4px 4px}.companion-hub .hub-rail button{width:auto;min-height:38px;padding:8px 11px;font-size:12px}.companion-hub .hub-content{padding:18px 14px 30px}}\n@media(prefers-reduced-motion:reduce){.companion-hub .hub-rail button{transition:none}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"mhW/LDC8DbpNWzS8CaxEQgABGoFZB2Kba0XpJ9Ax0EXMtGnfZpK1g9XWrMf1bc1TIBrW9WrVk7WFIug8z8ErAg=="}