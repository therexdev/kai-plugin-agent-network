{"manifest":{"schema":1,"apiVersion":2,"id":"kai.agent-network","name":"Agent Network","version":"0.1.1","description":"Create isolated private AI services, share signed invitations, discover configured relays, and review free service jobs. Paid rentals are not enabled.","entry":"index.html","permissions":["models.read","agent-network.read","agent-network.write","agent-network.manage","agent-network.network"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id);\n  let state = null, pending = false, lastMessage = \"\", lastError = false;\n  const call = (operation, input = {}) => window.kai.call(`agentNetwork.${operation}`, input);\n  const el = (tag, text, className) => { const node = document.createElement(tag); if (text !== undefined) node.textContent = text; if (className) node.className = className; return node; };\n  const banner = window.KaiPluginNotice.attach($(\"message\"), { focusTarget: () => document.querySelector(\"[data-tab][aria-selected=true]\") });\n  function message(text, error = false, force = true) { lastMessage = text; lastError = error; banner.show(text, { error, force, dismissible: !pending }); }\n  function tab(id) {\n    for (const button of document.querySelectorAll(\"[data-tab]\")) button.setAttribute(\"aria-selected\", String(button.dataset.tab === id));\n    for (const view of document.querySelectorAll(\".view\")) view.hidden = view.id !== id;\n  }\n  async function action(task, success) {\n    if (pending) return;\n    pending = true; message(\"Working…\");\n    const buttons = [...document.querySelectorAll(\"button:not(.kai-notice-close)\")]; buttons.forEach(b => { b.disabled = true; });\n    try { await task(); await refresh(); message(success || \"Saved.\"); }\n    catch (error) { message(error.message || String(error), true); }\n    finally { pending = false; buttons.forEach(b => { b.disabled = false; }); banner.show(lastMessage, { error: lastError, force: true }); }\n  }\n  function button(label, fn, secondary = true) { const node = el(\"button\", label, secondary ? \"secondary\" : \"primary\"); node.type = \"button\"; node.addEventListener(\"click\", () => action(fn)); return node; }\n  function options(select, items, empty) {\n    const selected = select.value; select.replaceChildren();\n    if (!items.length) { const option = el(\"option\", empty); option.value = \"\"; select.append(option); return; }\n    for (const item of items) { const option = el(\"option\", item.label); option.value = item.value; select.append(option); }\n    if (items.some(x => x.value === selected)) select.value = selected;\n  }\n  function chooseJob(id) { tab(\"jobs\"); $(\"quote-form\").hidden = false; $(\"job-service\").value = id; $(\"job-input\").focus(); }\n  async function exportService(id, kind) {\n    const result = await call(\"export\", { id, kind }); $(\"export-title\").textContent = result.name + (kind === \"definition\" ? \" · workflow package\" : \" · signed invitation\");\n    $(\"export-note\").textContent = kind === \"definition\" ? \"This package includes your service instructions. Share only if you intend to disclose how the agent works.\" : \"This signed public card identifies the service and its limits. It expires after seven days; save a new service version to renew it.\";\n    $(\"export-text\").value = result.text; $(\"export-panel\").hidden = false; $(\"export-panel\").scrollIntoView({ behavior: \"smooth\" });\n  }\n  function serviceCard(service, own) {\n    const card = el(\"article\", undefined, \"card\"), head = el(\"div\", undefined, \"card-head\");\n    head.append(el(\"span\", service.name.slice(0, 1).toUpperCase(), \"monogram\"), el(\"span\", own ? service.accepting ? \"Host open\" : \"Host paused\" : \"Free service\", \"tag\")); card.append(head, el(\"h3\", service.name), el(\"p\", service.description || \"Private service\"));\n    card.append(el(\"p\", own ? `${service.published ? \"Published to a relay\" : \"Local service\"} · version ${service.sequence}${service.safe ? \"\" : \" · needs review before use\"}` : `Operator ${service.owner} · expires ${new Date(service.expiresAt).toLocaleDateString()}`, \"meta\"));\n    const actions = el(\"div\", undefined, \"actions\");\n    actions.append(button(own ? \"Test locally\" : \"Request service\", () => chooseJob(service.id), false));\n    if (own) {\n      const more = el(\"details\", undefined, \"card-menu\"), menu = el(\"div\", undefined, \"card-menu-actions\"); more.append(el(\"summary\", \"More\"), menu); actions.append(more);\n      menu.append(button(\"Renew card\", () => call(\"save\", { id: service.id })), button(\"Export invitation\", () => exportService(service.id, \"card\")), button(\"Export workflow\", () => exportService(service.id, \"definition\")), button(\"Publish\", () => call(\"publish\", { id: service.id })), button(service.accepting ? \"Pause hosting\" : \"Accept jobs\", () => call(\"accepting\", { id: service.id, enabled: !service.accepting })));\n      if (service.published) menu.append(button(\"Retire listing\", () => call(\"retire\", { id: service.id })));\n    }\n    card.append(actions); return card;\n  }\n  function jobCard(job) {\n    const card = el(\"article\", undefined, \"card\"), head = el(\"div\", undefined, \"card-head\");\n    head.append(el(\"h3\", job.name), el(\"span\", job.status.replaceAll(\"_\", \" \"), \"tag\")); card.append(head, el(\"p\", `${job.role === \"host\" ? \"Hosting\" : \"Requested\"} · ${new Date(job.at).toLocaleString()} · ${job.modelCalls} model calls`, \"meta\"));\n    if (job.error) card.append(el(\"p\", job.error));\n    const actions = el(\"div\", undefined, \"actions\");\n    if (job.role === \"buyer\" && job.status === \"quoted\") actions.append(button(\"Review & run\", () => call(\"submit\", { id: job.id }), false));\n    if (job.hasOutput) actions.append(button(\"View result\", async () => { const detail = await call(\"jobDetail\", { id: job.id, role: job.role }); $(\"result-title\").textContent = detail.name + \" · \" + detail.status; $(\"result-output\").textContent = typeof detail.output === \"string\" ? detail.output : JSON.stringify(detail.output, null, 2); $(\"result-panel\").hidden = false; $(\"result-panel\").scrollIntoView({ behavior: \"smooth\" }); }));\n    const perform = action => () => call(\"job\", { id: job.id, role: job.role, action });\n    if (job.role === \"buyer\" && job.status === \"delivered\") actions.append(button(\"Accept result\", perform(\"accept\"), false), button(\"Reject result\", perform(\"reject\")));\n    if (job.role === \"host\" && job.status === \"waiting\") actions.append(button(\"Approve step\", perform(\"approve\"), false));\n    if (job.role === \"host\" && job.status === \"interrupted\") actions.append(button(\"Review & resume\", perform(\"resume\")));\n    if (![\"accepted\", \"cancelled\", \"failed\", \"rejected\"].includes(job.status)) actions.append(button(\"Cancel\", perform(\"cancel\")));\n    else actions.append(button(\"Remove receipt\", perform(\"remove\")));\n    card.append(actions); return card;\n  }\n  function render() {\n    $(\"services-count\").textContent = state.agents.length; $(\"jobs-count\").textContent = state.jobs.length; $(\"relay-count\").textContent = state.endpoints.length;\n    $(\"session\").textContent = state.sessionActive ? `Session active · ${state.privacyMode === \"local-only\" ? \"Local-Only privacy\" : state.endpoints.length ? \"Relays configured\" : \"Local services\"}` : \"Session paused · saved data retained\";\n    $(\"directory-note\").textContent = state.notice;\n    $(\"address\").value = state.address || \"\";\n    $(\"start-session\").textContent = state.sessionActive ? \"Apply connection settings\" : \"Start session\";\n    for (const [id, data, renderItem, empty] of [[\"service-list\", state.agents, s => serviceCard(s, true), \"Your first agent starts here. Start a session in Network settings, then create a local agent.\"], [\"directory-list\", state.cards, s => serviceCard(s, false), \"Connect to a directory. Add a relay in Network settings, import a signed invitation, or create a local agent.\"], [\"job-list\", state.jobs, jobCard, \"No jobs yet. Test a local service or request one from your saved invitations.\"]]) {\n      $(id).replaceChildren(...(data.length ? data.map(renderItem) : [el(\"p\", empty, \"empty\")]));\n    }\n    options($(\"model\"), state.models.map(m => ({ value: m.alias, label: m.label || m.alias })), \"No installed local models\");\n    const services = [...state.agents.map(s => ({ value: s.id, label: s.name + \" · this device\" })), ...state.cards.filter(c => !state.agents.some(s => s.id === c.id)).map(s => ({ value: s.id, label: s.name + \" · external\" }))];\n    options($(\"job-service\"), services, \"Create or import a service first\");\n  }\n  async function refresh(initial = false) { state = await call(\"status\"); if (initial) $(\"endpoints\").value = state.endpoints.join(\"\\n\"); render(); }\n  document.querySelectorAll(\"[data-tab]\").forEach(b => b.addEventListener(\"click\", () => tab(b.dataset.tab)));\n  $(\"create-agent\").addEventListener(\"click\", () => { $(\"service-editor\").hidden = false; $(\"service-name\").focus(); });\n  $(\"close-create\").addEventListener(\"click\", () => $(\"service-editor\").hidden = true);\n  $(\"show-import\").addEventListener(\"click\", () => { $(\"import-form\").hidden = false; $(\"invitation\").focus(); });\n  $(\"close-import\").addEventListener(\"click\", () => $(\"import-form\").hidden = true);\n  $(\"request-agent\").addEventListener(\"click\", () => { $(\"quote-form\").hidden = false; $(\"job-input\").focus(); });\n  $(\"close-request\").addEventListener(\"click\", () => $(\"quote-form\").hidden = true);\n  $(\"close-result\").addEventListener(\"click\", () => $(\"result-panel\").hidden = true);\n  $(\"refresh\").addEventListener(\"click\", () => action(() => call(\"refresh\"), \"Service status refreshed.\"));\n  $(\"settings-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(() => call(\"settings\", { enabled: true, endpoints: $(\"endpoints\").value.split(/\\r?\\n/).map(s => s.trim()).filter(Boolean) }), \"Session started. Services are available while this plugin is open.\"); });\n  $(\"stop-session\").addEventListener(\"click\", () => action(() => call(\"settings\", { enabled: false }), \"Service session paused.\"));\n  $(\"create-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(async () => { const input = { name: $(\"service-name\").value, description: $(\"service-description\").value, template: $(\"template\").value, model: $(\"model\").value }; if ($(\"instructions\").value.trim()) input.instructions = $(\"instructions\").value; await call(\"save\", input); $(\"service-editor\").hidden = true; }, \"Service saved locally. Test it before sharing.\"); });\n  $(\"load-workflows\").addEventListener(\"click\", () => action(async () => { const choices = await call(\"workflowChoices\"); options($(\"workflow\"), choices.map(w => ({ value: w.id, label: w.name })), \"No compatible saved workflows\"); }, \"Compatible workflows loaded.\"));\n  $(\"from-workflow\").addEventListener(\"click\", () => action(async () => { await call(\"fromWorkflow\", { workflowId: $(\"workflow\").value }); $(\"service-editor\").hidden = true; }, \"Workflow copied into a local service.\"));\n  $(\"search-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(() => call(\"discover\", { query: $(\"query\").value }), \"Configured relays searched. Valid service cards are saved here.\"); });\n  $(\"import-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(async () => { await call(\"import\", { text: $(\"invitation\").value }); $(\"import-form\").hidden = true; }, \"Signed invitation verified and saved.\"); });\n  $(\"quote-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(async () => { await call(\"quote\", { id: $(\"job-service\").value, input: $(\"job-input\").value }); $(\"quote-form\").hidden = true; }, \"Quote requested. Review and run when the host returns a quote.\"); });\n  $(\"close-export\").addEventListener(\"click\", () => { $(\"export-panel\").hidden = true; });\n  $(\"select-export\").addEventListener(\"click\", () => { $(\"export-text\").focus(); $(\"export-text\").select(); message(\"Text selected. Press Ctrl+C or Command+C to copy.\"); });\n  if (!window.kai || window.kai.apiVersion < 2) { message(\"This plugin needs KAI Core with plugin API 2. Update Core before opening it.\", true); document.querySelectorAll(\"button\").forEach(b => { b.disabled = true; }); return; }\n  refresh(true).catch(error => message(error.message, true));\n  const poll = setInterval(() => { if (!pending && state?.sessionActive) refresh().catch(error => message(error.message, true, false)); }, 3000);\n  window.addEventListener(\"unload\", () => clearInterval(poll));\n})();\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Agent Network · KAI</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"styles.css\"></head>\n<body><div class=\"app\"><header class=\"workspace-header\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"5\" r=\"2.5\"/><circle cx=\"5\" cy=\"18\" r=\"2.5\"/><circle cx=\"19\" cy=\"18\" r=\"2.5\"/><path d=\"m10.5 7-4 8.5M13.5 7l4 8.5M7.5 18h9\"/></svg><h1>Agent Network</h1><span class=\"workspace-caption\">Private services</span><button id=\"refresh\" class=\"quiet\">Check messages</button></header>\n<div class=\"hub-shell\"><nav class=\"hub-rail\" aria-label=\"Agent Network views\"><div class=\"hub-rail-label\">AGENT NETWORK</div><button data-tab=\"discover\" aria-selected=\"true\">Discover</button><button data-tab=\"services\" aria-selected=\"false\">My agents</button><button data-tab=\"jobs\" aria-selected=\"false\">Jobs</button><button data-tab=\"settings\" aria-selected=\"false\">Network settings</button><div class=\"rail-status\"><p id=\"session\">Loading service session…</p><dl class=\"metrics\"><div><dt>My agents</dt><dd id=\"services-count\">—</dd></div><div><dt>Jobs</dt><dd id=\"jobs-count\">—</dd></div><div><dt>Relays</dt><dd id=\"relay-count\">—</dd></div></dl></div></nav>\n<main class=\"hub-content\"><p id=\"message\" role=\"status\" aria-live=\"polite\" data-kai-notice></p><section id=\"services\" class=\"view\" hidden><div class=\"section-heading\"><div><p class=\"eyebrow\">YOUR SERVICES</p><h2>My agents</h2><p>Build from a template or a saved workflow. Test before opening your host to callers.</p></div><button id=\"create-agent\" class=\"primary\">Create agent</button></div><div id=\"service-list\" class=\"cards\"></div>\n<section id=\"service-editor\" class=\"service-editor\" hidden><div class=\"section-heading\"><h2>Create an agent</h2><button id=\"close-create\" type=\"button\" aria-label=\"Close agent editor\" title=\"Close\">×</button></div><div class=\"columns\"><form id=\"create-form\" class=\"panel\"><h3>Agent details</h3><label>Service name<input id=\"service-name\" required maxlength=\"80\" placeholder=\"Research brief\"></label><label>Description<textarea id=\"service-description\" maxlength=\"1000\" rows=\"2\" placeholder=\"What should people use this service for?\"></textarea></label><div class=\"form-row\"><label>Starting point<select id=\"template\"><option value=\"summary\">Text brief</option><option value=\"translate\">Translator</option><option value=\"review\">Report reviewer</option><option value=\"echo\">Connection check (no model)</option></select></label><label>Local model<select id=\"model\"><option value=\"\">Loading models…</option></select></label></div><label>Custom instructions <small>(optional)</small><textarea id=\"instructions\" maxlength=\"8000\" rows=\"3\" placeholder=\"Describe the result you want. The supplied input is added automatically.\"></textarea></label><button type=\"submit\" class=\"primary\">Save agent</button><p class=\"help\">Saving is local. Publishing and accepting outside jobs are separate choices.</p></form>\n<div class=\"panel\"><p class=\"eyebrow\">FROM YOUR WORKFLOWS</p><h3>Turn a flow into a service</h3><p>Use a saved local flow from Workflows. Only graphs without Brain, accounts, code, schedules, or nested workflows can be packaged.</p><label>Workflow<select id=\"workflow\"><option value=\"\">Load saved workflows</option></select></label><div class=\"actions\"><button id=\"load-workflows\" class=\"secondary\">Load workflows</button><button id=\"from-workflow\">Create service</button></div><hr><p class=\"eyebrow\">SAFE BY DESIGN</p><p>Service jobs use a separate encrypted identity, selected input, and installed local models. Each new service is limited to 180 seconds, 40 steps, and 12 model calls.</p></div></div></section></section>\n<section id=\"discover\" class=\"view\"><div class=\"section-heading\"><div><p class=\"eyebrow\">KAI AGENT NETWORK</p><h2>Find an agent for the job</h2><p>Explore signed service cards and send only the input you choose.</p></div><button id=\"show-import\">Import service card</button></div><p id=\"directory-note\" class=\"directory-note\"></p><form id=\"search-form\" class=\"search\"><label class=\"sr-only\" for=\"query\">Search services</label><input id=\"query\" maxlength=\"100\" placeholder=\"Search by service name or capability\"><button type=\"submit\" class=\"primary\">Search directory</button></form><div id=\"directory-list\" class=\"cards\"></div><form id=\"import-form\" class=\"panel\" hidden><div class=\"section-heading\"><h3>Import a service card</h3><button id=\"close-import\" type=\"button\" aria-label=\"Close service card import\" title=\"Close\">×</button></div><p>Paste a signed service card. KAI verifies its signature and expiry before saving it.</p><label>Signed invitation<textarea id=\"invitation\" rows=\"5\" maxlength=\"200000\" required spellcheck=\"false\" placeholder=\"Paste the exported JSON card\"></textarea></label><button type=\"submit\" class=\"primary\">Verify &amp; import</button></form></section>\n<section id=\"jobs\" class=\"view\" hidden><div class=\"section-heading\"><div><h2>Jobs</h2><p>Review quotes, follow execution, and inspect each delivery.</p></div><button id=\"request-agent\">Request a service</button></div><form id=\"quote-form\" class=\"panel\" hidden><div class=\"section-heading\"><h3>Request a service</h3><button id=\"close-request\" type=\"button\" aria-label=\"Close service request\" title=\"Close\">×</button></div><label>Service<select id=\"job-service\" required></select></label><label>Input to share<textarea id=\"job-input\" rows=\"4\" maxlength=\"12000\" required placeholder=\"Only the text you enter here can be sent to the operator.\"></textarea></label><button type=\"submit\" class=\"primary\">Request free quote</button><p class=\"help\">Review the returned quote, then approve sending the input. Your own services run locally.</p></form><div id=\"job-list\" class=\"cards\"></div><section id=\"result-panel\" class=\"panel\" hidden><div class=\"section-heading\"><h3 id=\"result-title\">Result</h3><button id=\"close-result\" type=\"button\" aria-label=\"Close result\" title=\"Close\">×</button></div><pre id=\"result-output\"></pre></section></section>\n<section id=\"settings\" class=\"view\" hidden><div class=\"section-heading\"><div><h2>Network settings</h2><p>Choose the independent relays that carry your encrypted service messages.</p></div></div><form id=\"settings-form\" class=\"panel\"><h3>Choose where services connect</h3><p>No public directory is preconfigured. Use a compatible KAI Agent Network relay you operate or trust. Leave this empty to test your own services and export invitations locally.</p><label>HTTPS relay origins <small>(one per line, up to three)</small><textarea id=\"endpoints\" rows=\"3\" placeholder=\"https://relay.example.org\" spellcheck=\"false\"></textarea></label><div class=\"actions\"><button id=\"start-session\" type=\"submit\" class=\"primary\">Start session</button><button id=\"stop-session\" type=\"button\" class=\"secondary\">Pause session</button></div><p class=\"help\">Local-Only privacy blocks relay traffic. A session runs only while this plugin is open. Reopening the plugin requires starting a session again.</p><label>Public service address<input id=\"address\" readonly placeholder=\"Created when you enable services\"></label></form><div class=\"panel\"><h3>What this release supports</h3><p>Signed free service cards, encrypted private jobs, local workflow execution, configured relay discovery, and result review are available. Paid rentals, escrow, marketplace contracts, and mainnet reputation are unavailable.</p></div></section>\n<section id=\"export-panel\" class=\"panel\" hidden><div class=\"section-heading\"><h3 id=\"export-title\">Export</h3><button id=\"close-export\" type=\"button\" class=\"quiet\" aria-label=\"Close export\" title=\"Close\">×</button></div><p id=\"export-note\"></p><textarea id=\"export-text\" rows=\"12\" readonly spellcheck=\"false\" aria-label=\"Exported service JSON\"></textarea><button id=\"select-export\" class=\"secondary\">Select text to copy</button></section><p class=\"footnote\">Private service preview · Paid rentals and mainnet payments are not enabled.</p></main></div></div><script src=\"kai-notices.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","styles.css":":root{color-scheme:light;--bg:#f4f7fd;--surface:#fff;--line:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{color:var(--text);background:#fff;border:1px solid var(--line);padding:8px 12px;border-radius:9px;cursor:pointer;font-size:12px}button:hover:enabled{background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.45;cursor:default}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.primary:hover:enabled{background:#0c4ed3;color:#fff}.secondary,.quiet{background:#fff}.quiet{font-size:11px;padding:7px 10px}input,select,textarea{width:100%;min-width:0;max-width:100%;border:1px solid var(--line);border-radius:9px;background:#f9fbff;color:var(--text);padding:10px 12px;font-size:12px}textarea{resize:vertical;line-height:1.7}label{display:flex;flex-direction:column;gap:7px;margin-bottom:18px;font-size:12px;color:var(--muted)}label small{font-size:10px}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.workspace-header{height:74px;display:flex;align-items:center;gap:11px;padding:0 26px;border-bottom:1px solid var(--line);background:var(--bg)}.workspace-header svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-header h1{font-size:15px;font-weight:650;line-height:1.4;margin:0}.workspace-caption{margin-left:auto;font-size:10px;color:var(--muted)}.hub-shell{display:grid;grid-template-columns:170px minmax(0,1fr);min-height:calc(100dvh - 74px)}.hub-rail{display:flex;flex-direction:column;gap:3px;padding:20px 10px 24px 12px;background:#fff;border-right:1px solid var(--line)}.hub-rail-label{padding:3px 8px 15px;font-size:9px;letter-spacing:.09em;color:var(--muted)}.hub-rail>button{border:0;background:transparent;text-align:left;padding:10px 9px;min-height:37px;font-size:12px;line-height:1.4}.hub-rail>button[aria-selected=true]{background:#edf4ff;color:var(--accent);font-weight:600}.rail-status{padding:16px 8px 0;margin-top:auto}.rail-status p{font-size:10px;line-height:1.7;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}.metrics{margin:14px 0 0;font-size:10px;color:var(--muted)}.metrics>div{display:flex;justify-content:space-between;gap:7px;margin:7px 0}.metrics dd{margin:0;color:var(--text)}.hub-content{min-width:0;padding:26px 26px 34px}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px}.section-heading h2{margin:0 0 8px;font-size:30px;letter-spacing:-.8px;line-height:1.3;font-weight:600}.section-heading p{margin:0;color:var(--muted);font-size:12px;line-height:1.7}.section-heading .eyebrow{margin-bottom:9px}.section-heading>button{flex:none}.section-heading h3{font-size:15px;margin:0}.eyebrow{font-size:10px!important;font-weight:650;letter-spacing:1.4px;color:var(--accent)!important;margin:0 0 8px}.panel{padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;margin-bottom:20px;min-width:0}.panel h3{font-size:16px;margin:0 0 14px}.panel p{font-size:12px;line-height:1.7;color:var(--muted);margin:0 0 17px}.panel .help{font-size:11px;margin:15px 0 0}.panel .section-heading{align-items:center;margin-bottom:16px}.panel .section-heading h3{margin:0}.columns{display:grid;grid-template-columns:1.15fr 1fr;gap:20px}.columns>.panel{margin-bottom:0}.service-editor{margin-top:26px}.service-editor>.section-heading{align-items:center}.service-editor>.section-heading h2{font-size:22px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:16px}.card{display:flex;flex-direction:column;align-items:stretch;padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;min-width:0}.card-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:20px}.monogram{width:44px;height:44px;flex:none;display:grid;place-items:center;border-radius:14px;background:#edf4ff;color:var(--accent);font-size:22px;font-weight:700}.tag{display:inline-block;border-radius:8px;background:#edf4ff;color:#355881;padding:5px 9px;font-size:10px;line-height:1.4}.card h3{font-size:18px;line-height:1.4;margin:0 0 10px;overflow-wrap:anywhere}.card>p{font-size:12px;line-height:1.7;color:var(--muted);margin:0 0 16px;overflow-wrap:anywhere}.card>p.meta{font-size:10px}.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.card>.actions{margin-top:auto}.actions button{font-size:11px;padding:8px 10px}.card-menu{position:relative}.card-menu>summary{list-style:none;cursor:pointer;font-size:11px;padding:8px 11px;border:1px solid var(--line);border-radius:9px}.card-menu>summary::-webkit-details-marker{display:none}.card-menu-actions{position:absolute;top:40px;right:0;z-index:10;display:grid;min-width:165px;padding:5px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px #15234018}.card-menu-actions button{border:0;text-align:left;white-space:normal}.search{display:flex;gap:10px;max-width:650px;margin-bottom:22px}.search input{flex:1}.search button{flex:none}.directory-note{color:var(--muted);font-size:11px;margin:0 0 20px;line-height:1.7}.directory-note:empty{display:none}.empty{grid-column:1/-1;text-align:center;margin:0 auto;padding:60px 28px;max-width:580px;color:var(--muted);font-size:12px;line-height:1.8}.empty:before{content:\"✧\";display:block;font-size:44px;color:var(--accent);margin-bottom:16px}.view>.cards{margin-bottom:22px}#job-list{grid-template-columns:1fr}#job-list .card{padding:20px}#job-list .card-head{margin-bottom:10px}#job-list h3{font-size:15px;margin:0}#job-list .meta{margin-bottom:14px}pre{font:12px/1.7 Consolas,ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere;padding:16px;background:#f5f8fe;border:1px solid var(--line);border-radius:10px;max-height:380px;overflow:auto}hr{border:0;border-top:1px solid var(--line);margin:22px 0}.footnote{font-size:10px;text-align:center;color:var(--muted);margin:30px 0 0}#message:empty{display:none}#message{font-size:12px;color:var(--muted);overflow-wrap:anywhere}#message.error{color:var(--danger)}#address{font-family:Consolas,ui-monospace,monospace;font-size:11px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}@media(max-width:1000px){.columns{grid-template-columns:1fr}.hub-content{padding:23px 20px}.section-heading h2{font-size:25px}}@media(max-width:800px){.hub-shell{grid-template-columns:145px minmax(0,1fr)}.hub-content{padding:20px 16px}.section-heading{flex-wrap:wrap;gap:14px}.section-heading h2{font-size:24px}.panel,.card{padding:20px}.form-row{grid-template-columns:1fr;gap:0}}@media(max-width:600px){.workspace-header{height:65px;padding:0 16px}.workspace-caption{display:none}.workspace-header>.quiet{margin-left:auto}.hub-shell{grid-template-columns:1fr;min-height:calc(100dvh - 65px)}.hub-rail{flex-direction:row;flex-wrap:wrap;padding:10px;border-right:0;border-bottom:1px solid var(--line)}.hub-rail-label,.rail-status{display:none}.hub-rail>button{flex:1;text-align:center;padding:8px 6px;font-size:10px}.hub-content{padding:20px 14px}.section-heading h2{font-size:25px}.search{flex-wrap:wrap}.search input{flex-basis:100%}.cards{grid-template-columns:1fr}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"my8hO8t1OXBo5ovoVbNSCZ/TKn13OlktOYDisX80+BOiox2Zve6CxfWeF8g/Xt3Wm/bVpsP+1ZzmCVAYm8gdBg=="}