{"manifest":{"schema":1,"apiVersion":2,"id":"kai.agent-network","name":"Agent Network","version":"0.1.0","description":"Create isolated private AI services, share signed invitations, discover configured relays, and review free service jobs. Paid rentals are not enabled.","entry":"index.html","permissions":["models.read","agent-network.read","agent-network.write","agent-network.manage","agent-network.network"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id);\n  let state = null, pending = false;\n  const call = (operation, input = {}) => window.kai.call(`agentNetwork.${operation}`, input);\n  const el = (tag, text, className) => { const node = document.createElement(tag); if (text !== undefined) node.textContent = text; if (className) node.className = className; return node; };\n  function message(text, error = false) { $(\"message\").textContent = text; $(\"message\").className = error ? \"error\" : \"\"; }\n  function tab(id) {\n    for (const button of document.querySelectorAll(\"[data-tab]\")) button.setAttribute(\"aria-selected\", String(button.dataset.tab === id));\n    for (const view of document.querySelectorAll(\".view\")) view.hidden = view.id !== id;\n  }\n  async function action(task, success) {\n    if (pending) return;\n    pending = true; message(\"Working…\");\n    const buttons = [...document.querySelectorAll(\"button\")]; buttons.forEach(b => { b.disabled = true; });\n    try { await task(); await refresh(); message(success || \"Saved.\"); }\n    catch (error) { message(error.message || String(error), true); }\n    finally { pending = false; buttons.forEach(b => { b.disabled = false; }); }\n  }\n  function button(label, fn, secondary = true) { const node = el(\"button\", label, secondary ? \"secondary\" : \"\"); node.type = \"button\"; node.addEventListener(\"click\", () => action(fn)); return node; }\n  function options(select, items, empty) {\n    const selected = select.value; select.replaceChildren();\n    if (!items.length) { const option = el(\"option\", empty); option.value = \"\"; select.append(option); return; }\n    for (const item of items) { const option = el(\"option\", item.label); option.value = item.value; select.append(option); }\n    if (items.some(x => x.value === selected)) select.value = selected;\n  }\n  function chooseJob(id) { tab(\"jobs\"); $(\"job-service\").value = id; $(\"job-input\").focus(); }\n  async function exportService(id, kind) {\n    const result = await call(\"export\", { id, kind }); $(\"export-title\").textContent = result.name + (kind === \"definition\" ? \" · workflow package\" : \" · signed invitation\");\n    $(\"export-note\").textContent = kind === \"definition\" ? \"This package includes your service instructions. Share only if you intend to disclose how the agent works.\" : \"This signed public card identifies the service and its limits. It expires after seven days; save a new service version to renew it.\";\n    $(\"export-text\").value = result.text; $(\"export-panel\").hidden = false; $(\"export-panel\").scrollIntoView({ behavior: \"smooth\" });\n  }\n  function serviceCard(service, own) {\n    const card = el(\"article\", undefined, \"card\"), head = el(\"div\", undefined, \"card-head\"), text = el(\"div\");\n    text.append(el(\"h3\", service.name), el(\"p\", service.description || \"Private service\")); head.append(text, el(\"span\", own ? service.accepting ? \"Accepting jobs\" : \"Paused\" : \"Free service\", \"tag\")); card.append(head);\n    card.append(el(\"p\", own ? `${service.published ? \"Published to a relay\" : \"Local service\"} · version ${service.sequence}${service.safe ? \"\" : \" · needs review before use\"}` : `Operator ${service.owner} · expires ${new Date(service.expiresAt).toLocaleDateString()}`, \"meta\"));\n    const actions = el(\"div\", undefined, \"actions\");\n    actions.append(button(own ? \"Test locally\" : \"Request service\", () => chooseJob(service.id), false));\n    if (own) {\n      actions.append(button(\"Renew card\", () => call(\"save\", { id: service.id })), button(\"Export invitation\", () => exportService(service.id, \"card\")), button(\"Export workflow\", () => exportService(service.id, \"definition\")), button(\"Publish\", () => call(\"publish\", { id: service.id })), button(service.accepting ? \"Pause hosting\" : \"Accept jobs\", () => call(\"accepting\", { id: service.id, enabled: !service.accepting })));\n      if (service.published) actions.append(button(\"Retire listing\", () => call(\"retire\", { id: service.id })));\n    }\n    card.append(actions); return card;\n  }\n  function jobCard(job) {\n    const card = el(\"article\", undefined, \"card\"), head = el(\"div\", undefined, \"card-head\");\n    head.append(el(\"h3\", job.name), el(\"span\", job.status.replaceAll(\"_\", \" \"), \"tag\")); card.append(head, el(\"p\", `${job.role === \"host\" ? \"Hosting\" : \"Requested\"} · ${new Date(job.at).toLocaleString()} · ${job.modelCalls} model calls`, \"meta\"));\n    if (job.error) card.append(el(\"p\", job.error));\n    const actions = el(\"div\", undefined, \"actions\");\n    if (job.role === \"buyer\" && job.status === \"quoted\") actions.append(button(\"Review & run\", () => call(\"submit\", { id: job.id }), false));\n    if (job.hasOutput) actions.append(button(\"View result\", async () => { const detail = await call(\"jobDetail\", { id: job.id, role: job.role }); $(\"result-title\").textContent = detail.name + \" · \" + detail.status; $(\"result-output\").textContent = typeof detail.output === \"string\" ? detail.output : JSON.stringify(detail.output, null, 2); $(\"result-panel\").hidden = false; $(\"result-panel\").scrollIntoView({ behavior: \"smooth\" }); }));\n    const perform = action => () => call(\"job\", { id: job.id, role: job.role, action });\n    if (job.role === \"buyer\" && job.status === \"delivered\") actions.append(button(\"Accept result\", perform(\"accept\"), false), button(\"Reject result\", perform(\"reject\")));\n    if (job.role === \"host\" && job.status === \"waiting\") actions.append(button(\"Approve step\", perform(\"approve\"), false));\n    if (job.role === \"host\" && job.status === \"interrupted\") actions.append(button(\"Review & resume\", perform(\"resume\")));\n    if (![\"accepted\", \"cancelled\", \"failed\", \"rejected\"].includes(job.status)) actions.append(button(\"Cancel\", perform(\"cancel\")));\n    else actions.append(button(\"Remove receipt\", perform(\"remove\")));\n    card.append(actions); return card;\n  }\n  function render() {\n    $(\"services-count\").textContent = state.agents.length; $(\"jobs-count\").textContent = state.jobs.length; $(\"relay-count\").textContent = state.endpoints.length;\n    $(\"session\").textContent = state.sessionActive ? `Session active · ${state.privacyMode === \"local-only\" ? \"Local-Only privacy\" : state.endpoints.length ? \"Relays configured\" : \"Local services\"}` : \"Session paused · saved data retained\";\n    $(\"directory-note\").textContent = state.notice;\n    $(\"address\").value = state.address || \"\";\n    $(\"start-session\").textContent = state.sessionActive ? \"Apply connection settings\" : \"Start session\";\n    for (const [id, data, renderItem, empty] of [[\"service-list\", state.agents, s => serviceCard(s, true), \"Your first useful service starts here. Start a session in Connection, then create a service below.\"], [\"directory-list\", state.cards, s => serviceCard(s, false), \"No invitations saved yet. Search a configured relay or import a signed invitation.\"], [\"job-list\", state.jobs, jobCard, \"No jobs yet. Test a local service or request one from your saved invitations.\"]]) {\n      $(id).replaceChildren(...(data.length ? data.map(renderItem) : [el(\"p\", empty, \"empty\")]));\n    }\n    options($(\"model\"), state.models.map(m => ({ value: m.alias, label: m.label || m.alias })), \"No installed local models\");\n    const services = [...state.agents.map(s => ({ value: s.id, label: s.name + \" · this device\" })), ...state.cards.filter(c => !state.agents.some(s => s.id === c.id)).map(s => ({ value: s.id, label: s.name + \" · external\" }))];\n    options($(\"job-service\"), services, \"Create or import a service first\");\n  }\n  async function refresh(initial = false) { state = await call(\"status\"); if (initial) $(\"endpoints\").value = state.endpoints.join(\"\\n\"); render(); }\n  document.querySelectorAll(\"[data-tab]\").forEach(b => b.addEventListener(\"click\", () => tab(b.dataset.tab)));\n  $(\"refresh\").addEventListener(\"click\", () => action(() => call(\"refresh\"), \"Service status refreshed.\"));\n  $(\"settings-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(() => call(\"settings\", { enabled: true, endpoints: $(\"endpoints\").value.split(/\\r?\\n/).map(s => s.trim()).filter(Boolean) }), \"Session started. Services are available while this plugin is open.\"); });\n  $(\"stop-session\").addEventListener(\"click\", () => action(() => call(\"settings\", { enabled: false }), \"Service session paused.\"));\n  $(\"create-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(async () => { const input = { name: $(\"service-name\").value, description: $(\"service-description\").value, template: $(\"template\").value, model: $(\"model\").value }; if ($(\"instructions\").value.trim()) input.instructions = $(\"instructions\").value; await call(\"save\", input); }, \"Service saved locally. Test it before sharing.\"); });\n  $(\"load-workflows\").addEventListener(\"click\", () => action(async () => { const choices = await call(\"workflowChoices\"); options($(\"workflow\"), choices.map(w => ({ value: w.id, label: w.name })), \"No compatible saved workflows\"); }, \"Compatible workflows loaded.\"));\n  $(\"from-workflow\").addEventListener(\"click\", () => action(() => call(\"fromWorkflow\", { workflowId: $(\"workflow\").value }), \"Workflow copied into a local service.\"));\n  $(\"search-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(() => call(\"discover\", { query: $(\"query\").value }), \"Configured relays searched. Valid service cards are saved here.\"); });\n  $(\"import-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(() => call(\"import\", { text: $(\"invitation\").value }), \"Signed invitation verified and saved.\"); });\n  $(\"quote-form\").addEventListener(\"submit\", event => { event.preventDefault(); action(() => call(\"quote\", { id: $(\"job-service\").value, input: $(\"job-input\").value }), \"Quote requested. Review and run when the host returns a quote.\"); });\n  $(\"close-export\").addEventListener(\"click\", () => { $(\"export-panel\").hidden = true; });\n  $(\"select-export\").addEventListener(\"click\", () => { $(\"export-text\").focus(); $(\"export-text\").select(); message(\"Text selected. Press Ctrl+C or Command+C to copy.\"); });\n  if (!window.kai || window.kai.apiVersion < 2) { message(\"This plugin needs KAI Core with plugin API 2. Update Core before opening it.\", true); document.querySelectorAll(\"button\").forEach(b => { b.disabled = true; }); return; }\n  refresh(true).catch(error => message(error.message, true));\n  const poll = setInterval(() => { if (!pending && state?.sessionActive) refresh().catch(error => message(error.message, true)); }, 3000);\n  window.addEventListener(\"unload\", () => clearInterval(poll));\n})();\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Agent Network · KAI</title><link rel=\"stylesheet\" href=\"styles.css\"></head>\n<body><div class=\"app\"><header><div class=\"brand\"><span class=\"logo\" aria-hidden=\"true\">K</span><div><span class=\"eyebrow\">KAI PLUGINS</span><h1>Agent Network</h1></div></div><button id=\"refresh\" class=\"quiet\">Refresh</button></header>\n<section class=\"intro\"><div><p class=\"eyebrow\">YOUR EXPERTISE, AVAILABLE AS A SERVICE</p><h2>Build locally.<br>Share deliberately.</h2><p>Package a useful agent, choose what it receives, and review every result. Your Brain and connected accounts stay private.</p></div><div class=\"intro-aside\"><span class=\"badge\">PRIVATE SERVICES · FREE</span><p id=\"session\">Loading service session…</p><small>Paid rentals and mainnet payments are not enabled in this release.</small></div></section>\n<p id=\"message\" role=\"status\" aria-live=\"polite\"></p><div class=\"metrics\"><div><span id=\"services-count\">—</span><small>YOUR SERVICES</small></div><div><span id=\"jobs-count\">—</span><small>SERVICE JOBS</small></div><div><span id=\"relay-count\">—</span><small>CONFIGURED RELAYS</small></div></div>\n<nav class=\"tabs\" aria-label=\"Agent Network views\"><button data-tab=\"services\" aria-selected=\"true\">My services</button><button data-tab=\"discover\" aria-selected=\"false\">Discover</button><button data-tab=\"jobs\" aria-selected=\"false\">Jobs</button><button data-tab=\"settings\" aria-selected=\"false\">Connection</button></nav>\n<main><section id=\"services\" class=\"view\"><div class=\"section-heading\"><h2>Your service collection</h2><span>Saved on this device</span></div><div id=\"service-list\" class=\"cards\"></div>\n<div class=\"columns\"><form id=\"create-form\" class=\"panel\"><p class=\"eyebrow\">NEW SERVICE</p><h3>Give your agent a job</h3><label>Service name<input id=\"service-name\" required maxlength=\"80\" placeholder=\"Research brief\"></label><label>Description<textarea id=\"service-description\" maxlength=\"1000\" rows=\"2\" placeholder=\"What should people use this service for?\"></textarea></label><div class=\"form-row\"><label>Starting point<select id=\"template\"><option value=\"summary\">Text brief</option><option value=\"translate\">Translator</option><option value=\"review\">Report reviewer</option><option value=\"echo\">Connection check (no model)</option></select></label><label>Local model<select id=\"model\"><option value=\"\">Loading models…</option></select></label></div><label>Custom instructions <small>(optional)</small><textarea id=\"instructions\" maxlength=\"8000\" rows=\"3\" placeholder=\"Describe the result you want. The supplied input is added automatically.\"></textarea></label><button type=\"submit\">Save service</button><p class=\"help\">Saving is local. Publishing and accepting outside jobs are separate choices.</p></form>\n<div class=\"panel\"><p class=\"eyebrow\">FROM YOUR WORKFLOWS</p><h3>Turn a flow into a service</h3><p>Use a saved local flow from Workflows. Only graphs without Brain, accounts, code, schedules, or nested workflows can be packaged.</p><label>Workflow<select id=\"workflow\"><option value=\"\">Load saved workflows</option></select></label><div class=\"actions\"><button id=\"load-workflows\" class=\"secondary\">Load workflows</button><button id=\"from-workflow\">Create service</button></div><hr><p class=\"eyebrow\">SAFE BY DESIGN</p><p>Service jobs use a separate encrypted identity, selected input, and installed local models. Each new service is limited to 180 seconds, 40 steps, and 12 model calls.</p></div></div></section>\n<section id=\"discover\" class=\"view\" hidden><div class=\"section-heading\"><h2>Discover private services</h2><span>Compatible relays</span></div><p id=\"directory-note\" class=\"panel\"></p><form id=\"search-form\" class=\"search\"><label class=\"sr-only\" for=\"query\">Search services</label><input id=\"query\" maxlength=\"100\" placeholder=\"Search by service name or capability\"><button type=\"submit\">Search relays</button></form><div id=\"directory-list\" class=\"cards\"></div><form id=\"import-form\" class=\"panel\"><h3>Have a private invitation?</h3><p>Paste a signed service card. KAI verifies its signature and expiry before saving it.</p><label>Signed invitation<textarea id=\"invitation\" rows=\"5\" maxlength=\"200000\" required spellcheck=\"false\" placeholder=\"Paste the exported JSON card\"></textarea></label><button type=\"submit\">Import invitation</button></form></section>\n<section id=\"jobs\" class=\"view\" hidden><div class=\"section-heading\"><h2>Requests and results</h2><span>No KAI payments</span></div><form id=\"quote-form\" class=\"panel\"><h3>Request a service</h3><label>Service<select id=\"job-service\" required></select></label><label>Input to share<textarea id=\"job-input\" rows=\"4\" maxlength=\"12000\" required placeholder=\"Only the text you enter here can be sent to the operator.\"></textarea></label><button type=\"submit\">Request free quote</button><p class=\"help\">Review the returned quote, then approve sending the input. Your own services run locally.</p></form><div id=\"job-list\" class=\"cards\"></div><section id=\"result-panel\" class=\"panel\" hidden><h3 id=\"result-title\">Result</h3><pre id=\"result-output\"></pre></section></section>\n<section id=\"settings\" class=\"view\" hidden><div class=\"section-heading\"><h2>Service connection</h2><span>Explicit access</span></div><form id=\"settings-form\" class=\"panel\"><h3>Choose where services connect</h3><p>No public directory is preconfigured. Use a compatible KAI Agent Network relay you operate or trust. Leave this empty to test your own services and export invitations locally.</p><label>HTTPS relay origins <small>(one per line, up to three)</small><textarea id=\"endpoints\" rows=\"3\" placeholder=\"https://relay.example.org\" spellcheck=\"false\"></textarea></label><div class=\"actions\"><button id=\"start-session\" type=\"submit\">Start session</button><button id=\"stop-session\" type=\"button\" class=\"secondary\">Pause session</button></div><p class=\"help\">Local-Only privacy blocks relay traffic. A session runs only while this plugin is open. Reopening the plugin requires starting a session again.</p><label>Public service address<input id=\"address\" readonly placeholder=\"Created when you enable services\"></label></form><div class=\"panel\"><h3>What this release supports</h3><p>Signed free service cards, encrypted private jobs, local workflow execution, configured relay discovery, and result review are available. Paid rentals, escrow, marketplace contracts, and mainnet reputation are unavailable.</p></div></section>\n<section id=\"export-panel\" class=\"panel\" hidden><div class=\"section-heading\"><h3 id=\"export-title\">Export</h3><button id=\"close-export\" class=\"quiet\">Close</button></div><p id=\"export-note\"></p><textarea id=\"export-text\" rows=\"12\" readonly spellcheck=\"false\" aria-label=\"Exported service JSON\"></textarea><button id=\"select-export\" class=\"secondary\">Select text to copy</button></section></main>\n<footer>KAI Agent Network <span>0.1.0 · Core API 2</span></footer></div><script src=\"app.js\"></script></body></html>\n","styles.css":":root{color-scheme:dark;--bg:#0d1119;--panel:#151c28;--line:#293344;--text:#e9eff8;--muted:#9aa9bb;--accent:#b4f5d1;--ink:#10271b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.app{max-width:1180px;margin:auto;padding:28px 40px}header,.brand,.section-heading,.actions,.form-row,footer{display:flex;align-items:center;gap:12px}header,.section-heading,footer{justify-content:space-between}.brand{gap:14px}.logo{display:grid;place-items:center;width:44px;height:44px;border:1px solid #45665a;border-radius:14px;color:var(--accent);font-size:24px;font-weight:800}.eyebrow{font-size:10px;font-weight:750;letter-spacing:.16em;color:var(--accent);margin:0 0 10px}h1{font-size:20px;line-height:1.2;margin:0}h2{font-size:23px;line-height:1.25;margin:0 0 12px}h3{font-size:18px;margin:0 0 12px}p{color:var(--muted);margin:0 0 16px}button,input,select,textarea{font:inherit}button{background:var(--accent);color:var(--ink);padding:11px 17px;border:1px solid transparent;border-radius:9px;font-weight:650;cursor:pointer}button:hover{filter:brightness(1.08)}button:disabled{opacity:.5;cursor:wait}button.secondary{background:#243044;color:var(--text);border-color:#37445b}button.quiet{background:transparent;color:var(--muted);border-color:var(--line)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.intro{display:grid;grid-template-columns:1.8fr 1fr;gap:50px;padding:48px 0 26px}.intro h2{font-size:43px;letter-spacing:-1.8px;font-weight:650;line-height:1.08}.intro p{max-width:590px}.intro-aside{align-self:center;border-left:1px solid var(--line);padding:16px 0 16px 28px}.badge{display:inline-block;border:1px solid #345346;border-radius:20px;font-size:9px;font-weight:700;letter-spacing:.1em;color:var(--accent);padding:5px 10px;margin-bottom:18px}.intro-aside p{color:var(--text);font-weight:600}.intro-aside small,.help{color:var(--muted);font-size:12px}#message{min-height:24px;margin:0 0 12px;color:var(--accent)}#message.error{color:#ffb7b2}.metrics{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:13px;overflow:hidden;margin:0 0 26px}.metrics>div{padding:16px 24px;display:flex;align-items:center;gap:16px}.metrics>div+div{border-left:1px solid var(--line)}.metrics span{font-size:28px;font-weight:550}.metrics small{font-size:10px;letter-spacing:.1em;color:var(--muted)}.tabs{display:flex;gap:5px;border-bottom:1px solid var(--line);margin-bottom:26px}.tabs button{background:transparent;color:var(--muted);border-radius:0;padding:13px 17px;border-bottom:2px solid transparent}.tabs button[aria-selected=true]{color:var(--accent);border-bottom-color:var(--accent)}.section-heading{margin:0 0 18px}.section-heading h2,.section-heading h3{margin:0}.section-heading>span{font-size:12px;color:var(--muted)}.cards{display:grid;gap:14px;margin-bottom:24px}.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:23px}.panel{margin-bottom:20px}.card p{white-space:pre-wrap;overflow-wrap:anywhere}.card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.card-head h3{margin-bottom:5px}.tag{font-size:11px;white-space:nowrap;color:var(--accent);background:#21372f;border:1px solid #304f41;padding:3px 9px;border-radius:14px}.meta{font-size:12px;color:var(--muted);margin:0 0 14px}.actions{flex-wrap:wrap;gap:8px}.actions button{font-size:12px;padding:8px 12px}.columns{display:grid;grid-template-columns:1.15fr 1fr;gap:20px;align-items:start}.form-row>*{flex:1;min-width:0}label{display:block;color:#ced7e3;font-size:13px;font-weight:550;margin-bottom:15px}label small{color:var(--muted);font-weight:400}input,select,textarea{display:block;background:#0e141f;color:var(--text);border:1px solid #334056;border-radius:8px;width:100%;padding:10px 12px;margin-top:7px;font-size:14px}textarea{resize:vertical;min-height:70px}input::placeholder,textarea::placeholder{color:#6f7e94}.help{margin:12px 0 0}.empty{padding:28px;border:1px dashed #38465d;border-radius:12px;color:var(--muted);text-align:center}.search{display:flex;gap:10px;margin-bottom:20px}.search input{margin:0;flex:1}.search button{flex-shrink:0}hr{border:0;border-top:1px solid var(--line);margin:26px 0}pre{padding:16px;background:#0e141f;white-space:pre-wrap;overflow-wrap:anywhere;max-height:500px;overflow:auto;font:13px/1.6 ui-monospace,monospace}footer{border-top:1px solid var(--line);padding-top:20px;margin-top:28px;color:var(--muted);font-size:11px}footer span{color:#63738a}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}@media(max-width:800px){.app{padding:22px}.intro{grid-template-columns:1fr;gap:10px}.intro h2{font-size:36px}.intro-aside{padding:12px 0;border:0}.columns{grid-template-columns:1fr}.metrics>div{padding:12px;display:block}.metrics small{display:block}.tabs button{padding:12px;font-size:13px}.section-heading>span{display:none}.form-row{display:block}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"F2TLL5qYG2aNNhKXiyYfg5BWqrUEzzebfxFPaHgyksC/mmfe/P258bvP/DtPrA8kYd37hB8raiz2uuBSBm5fAw=="}